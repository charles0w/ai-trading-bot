# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data (root runtime dir only — /data/* not data/, so atb/data/ source stays
# tracked). Exclude contents rather than the dir itself so the trained-model
# artifact can be negated back in: git cannot re-include a file whose parent
# DIRECTORY is excluded. model.json is versioned deliberately — one canonical
# model in git keeps Mac and Windows runs identical; retraining is an explicit
# commit, never an implicit per-machine divergence.
/data/*
!/data/model.json
!/data/predictions.jsonl
*.duckdb
*.duckdb.wal
*.parquet
*.csv
!tests/fixtures/*.csv

# Secrets
.env
.env.local
*.pem
credentials.json

# LLM call cache & logs
.llm_cache/
logs/
*.log

# Trade tickets (potentially sensitive)
tickets/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build
dist/
build/
*.egg-info/
*.pyc
*.db
